{
  "name": "game-industry-outreach-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,mjs}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"eslint.config.js\" \"index.html\" \"package.json\" \"package-lock.json\" \"tsconfig.json\" \".prettierrc.json\" \".vscode/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,mjs}\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"eslint.config.js\" \"index.html\" \"package.json\" \"package-lock.json\" \"tsconfig.json\" \".prettierrc.json\" \".vscode/**/*.json\"",
    "lint": "eslint --max-warnings=0 --ext .js,.mjs,.ts,.tsx src scripts tests vite.config.ts eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "feedback-report": "node scripts/feedback-report.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.12.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^10.13.0",
    "globals": "^15.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.56.0",
    "vite": "^6.2.4"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "allowScripts": {
    "esbuild": true
  }
}
